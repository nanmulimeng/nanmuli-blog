# Nanmuli Blog deployment environment example.
# Production must use private values and rotate any value that was ever committed.

DB_PASSWORD=your_secure_database_password
BLOG_SECURITY_ENCRYPTION_KEY=your_16_plus_char_encryption_key
COOKIE_SECURE=false

# Java -> Python crawler API key, also used by crawler API_KEYS at startup.
CRAWLER_API_KEY=your_shared_crawler_api_key

# Python -> Java internal callback/config key.
CRAWLER_CALLBACK_API_KEY=your_shared_callback_key

AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus
DIGEST_ENABLED=false

# Local/trial resource guardrails. Increase these on larger production hosts.
POSTGRES_MEM_LIMIT=768m
POSTGRES_CPUS=1.0
REDIS_MEM_LIMIT=192m
REDIS_CPUS=0.5
BACKEND_MEM_LIMIT=1024m
BACKEND_CPUS=1.5
BACKEND_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError
CRAWLER_MEM_LIMIT=1536m
CRAWLER_CPUS=1.5
FRONTEND_MEM_LIMIT=256m
FRONTEND_CPUS=0.5

# Crawler runtime protection. These defaults avoid local browser crawl spikes.
MAX_CONCURRENT_CRAWLS=2
DIGEST_PARALLEL_SECTIONS=1
DIGEST_GLOBAL_TIMEOUT=420
SEARCH_CRAWL_DEADLINE_SECONDS=180
AI_DIGEST_TOTAL_BUDGET=60000

# Optional proxy. Leave blank when not needed.
PROXY_URL=

# Container-network defaults.
JAVA_API_URL=http://backend:8081
CALLBACK_URL=http://backend:8081/api/internal/collector/callback
CRAWLER_CALLBACK_URL=http://backend:8081/api/internal/collector/callback

STORAGE_TYPE=local
CORS_ALLOWED_ORIGINS=https://nanmu.xyz,http://nanmu.xyz
